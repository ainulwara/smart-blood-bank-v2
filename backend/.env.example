# Change these values per hospital node when running three local Flask processes.
HOSPITAL_ID=A
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/blood_bank_hospital_a
SYNC_SHARED_SECRET=smart-blood-bank-demo-secret
JWT_SECRET_KEY=smart-blood-bank-demo-jwt-secret
SYNC_REQUEST_TIMEOUT=5
RETRY_INTERVAL_SECONDS=15
RETRY_BATCH_SIZE=50
JWT_EXPIRY_HOURS=8
LOW_STOCK_THRESHOLD=5
